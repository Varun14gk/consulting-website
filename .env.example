# Repo name as a path, e.g. /consulting-website. Leave empty for local dev at the root.
NEXT_PUBLIC_BASE_PATH=/consulting-website

# Full site origin (no trailing slash). Used for sitemap, OG tags, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://varun14gk.github.io

# Contact form endpoint from https://formspree.io (e.g. https://formspree.io/f/xxxxxxx). Optional.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# Booking embed link (Calendly / Cal.com). Optional.
NEXT_PUBLIC_BOOKING_URL=

# Analytics (set one, optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
